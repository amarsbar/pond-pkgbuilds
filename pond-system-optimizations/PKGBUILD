prepare() {
  cd $_gitname

  rm -f \
    etc/debuginfod/cachyos.urls \
    usr/bin/cachyos-bugreport.sh \
    usr/bin/paste-cachyos \
    usr/share/glib-2.0/schemas/zz_cachyos.org.gnome.login-screen.gschema.override \
    usr/share/icons/cachyos.svg

  mv usr/lib/sysctl.d/70-cachyos-settings.conf \
    usr/lib/sysctl.d/70-pond-system-optimizations.conf
  mv usr/lib/systemd/system/cachyos-iw-set-regdomain.path \
    usr/lib/systemd/system/pond-iw-set-regdomain.path
  mv usr/lib/systemd/system/cachyos-iw-set-regdomain.service \
    usr/lib/systemd/system/pond-iw-set-regdomain.service

  sed -i \
    -e 's/cachyos-iw-set-regdomain/pond-iw-set-regdomain/g' \
    usr/lib/systemd/system/pond-iw-set-regdomain.path \
    usr/lib/udev/rules.d/85-iw-regulatory.rules
  sed -i 's/CachyOS game-performance/Pond game-performance/g' \
    usr/bin/game-performance
}
package() {
  install -d "$pkgdir/etc"
  cp -rf "${srcdir}/${_gitname}/etc" "$pkgdir"
  install -d "$pkgdir/usr"
  cp -rf "${srcdir}/${_gitname}/usr" "$pkgdir"
}
