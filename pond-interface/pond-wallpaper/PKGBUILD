# Maintainer: Ammar Hossain <ammar@butterfly.so>

pkgname=pond-wallpaper
pkgver=0.1.1
pkgrel=1
pkgdesc='Wallpaper manager for Pond'
arch=('any')
url='https://github.com/bflycomputer/pond-interface'
license=('BSD-3-Clause')
depends=('qt6-declarative' 'qt6-wayland' 'quickshell')
makedepends=('qt6-shadertools')

_commit=3df68ac7d283b887c8fd82cd6778a6e9339f340b
source=("pond-interface-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('8ec59d796e3098996756a59a985c2c93f9459f903da98965eb62cc9ba420e24a')

build() {
  cd "pond-interface-$_commit/wallpaper/daylight"
  /usr/lib/qt6/bin/qsb --qt6 -o sky.frag.qsb sky.frag
}

package() {
  cd "pond-interface-$_commit"
  install -Dm644 wallpaper/daylight/{Sky.qml,SkyState.js,qmldir,sky.frag.qsb} \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/Daylight"
  install -Dm644 wallpaper/{qmldir,Window.qml,Content.qml,Reveal.qml} \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/Wallpaper"
  install -dm755 "$pkgdir/etc/skel/Pictures/Wallpapers"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
