# Maintainer: Ammar Hossain <ammar@butterfly.so>

pkgname=pond-plymouth-theme
pkgver=0.0
pkgrel=2
pkgdesc='Pond Plymouth boot, shutdown, and restart animations'
arch=('any')
url='https://github.com/bflycomputer/pond-interface'
license=('BSD-3-Clause')
depends=('plymouth' 'mkinitcpio')
_commit=a06beedcc396ec96f2c53a1414274a4fc75b81fa
source=("pond-interface-$_commit.tar.gz::$url/archive/$_commit.tar.gz"
        'pond-plymouth.hook'
        'pond-plymouth-update')
sha256sums=('61162a5d2c0c5d7540f93afbe68cde5c9c4cace57d76b59fd736d86cb8a84240'
            'c5dbb4d0e42a70e9d2781ac9eeb4aeac68ad6aafd9de124b3561dab6a153b647'
            '280157c0475b3e6f16d394b89c0c5f5738588f113aef2f3ad938053ec7ef65c9')

package() {
  local theme_dir="$pkgdir/usr/share/plymouth/themes/pond"
  cd "$srcdir/pond-interface-$_commit"
  install -Dm644 plymouth/pond.plymouth plymouth/pond.script -t "$theme_dir"
  install -Dm644 plymouth/assets/*.png -t "$theme_dir/assets"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$srcdir/pond-plymouth.hook" "$pkgdir/usr/share/libalpm/hooks/95-pond-plymouth.hook"
  install -Dm755 "$srcdir/pond-plymouth-update" "$pkgdir/usr/share/libalpm/scripts/pond-plymouth-update"
}
