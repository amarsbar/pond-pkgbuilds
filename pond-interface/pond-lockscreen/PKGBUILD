# Maintainer: Ammar Hossain <ammar@butterfly.so>

pkgname=pond-lockscreen
pkgver=0.1.0
pkgrel=1
pkgdesc='Pond session lock and SDDM greeter'
arch=('x86_64')
url='https://github.com/bflycomputer/pond-interface'
license=('BSD-3-Clause')
depends=(
  'coreutils'
  'glibc'
  'libgcc'
  'libstdc++'
  'networkmanager-qt'
  'pond-wallpaper'
  'qt6-base'
  'qt6-declarative>=6.11'
  'qt6-svg'
  'qt6-wayland'
  'quickshell>=0.3.1'
  'systemd'
  'ttf-onest'
  'sddm'
  'niri'
)
makedepends=('cmake' 'ninja' 'qt6-shadertools')

_commit=0c97b8416b9ae2559125706adce4837c616119d2
source=("pond-interface-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('83800a45bca6b0ef2d6a2b180fb60bdae851363260db4dd885c81e5efd5cd299')

build() {
  cmake -S "pond-interface-$_commit" -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_BUILD_WITH_INSTALL_RPATH=ON
  cmake --build build --target pond_wifi_statusplugin
  /usr/lib/qt6/bin/qsb --qt6 -o build/soft-light.frag.qsb \
    "pond-interface-$_commit/lockscreen/frontend/shaders/soft-light.frag"
}

package() {
  local destination="$pkgdir/usr/share/pond-interface"
  cd "pond-interface-$_commit"

  find lockscreen -type f \( -name '*.qml' -o -name '*.js' -o -name '*.png' -o -name '*.svg' \) \
    -exec install -Dm644 '{}' "$destination/{}" \;
  install -Dm644 "$srcdir/build/soft-light.frag.qsb" \
    "$destination/lockscreen/frontend/shaders/soft-light.frag.qsb"
  install -Dm644 lockscreen/greeter/{metadata.desktop,niri.kdl} -t "$destination/lockscreen/greeter"
  install -Dm644 lockscreen/greeter/sddm.conf "$pkgdir/usr/lib/sddm/sddm.conf.d/pond-lockscreen.conf"
  install -Dm755 "$srcdir/build/libpond_wifi_status.so" "$srcdir/build/Pond/WifiStatus/libpond_wifi_statusplugin.so" \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/WifiStatus"
  install -Dm644 "$srcdir/build/Pond/WifiStatus/"{qmldir,pond_wifi_status.qmltypes} \
    -t "$pkgdir/usr/lib/qt6/qml/Pond/WifiStatus"
  install -d "$pkgdir/etc/xdg/quickshell"
  ln -s /usr/share/pond-interface/lockscreen "$pkgdir/etc/xdg/quickshell/pond-lockscreen"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
