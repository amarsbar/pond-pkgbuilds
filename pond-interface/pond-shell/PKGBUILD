# Maintainer: Ammar Hossain <ammar@butterfly.so>

pkgname=pond-shell
pkgver=0.0
pkgrel=3
pkgdesc='Pond desktop shell for niri'
arch=('any')
url='https://github.com/bflycomputer/pond-interface'
license=('BSD-3-Clause')
depends=(
  'bluez'
  'brightnessctl'
  'capitaine-cursors'
  'ddcutil'
  'fastfetch'
  'gdk-pixbuf2'
  'iw'
  'networkmanager'
  'niri'
  'pipewire'
  'pond-lockscreen'
  'pond-screenshot'
  'pond-wallpaper'
  'python'
  'python-gobject'
  'qt6-declarative>=6.11'
  'qt6-svg'
  'qt6-wayland'
  'quickshell>=0.3.1'
  'systemd'
  'ttf-advent-pro'
  'ttf-ibm-plex'
  'ttf-onest'
  'upower'
  'zenity'
)

_commit=a06beedcc396ec96f2c53a1414274a4fc75b81fa
source=("pond-interface-$_commit.tar.gz::$url/archive/$_commit.tar.gz")
sha256sums=('61162a5d2c0c5d7540f93afbe68cde5c9c4cace57d76b59fd736d86cb8a84240')

package() {
  cd "pond-interface-$_commit"
  find shell -type f \( -name '*.qml' -o -name '*.js' -o -name 'qmldir' \
    -o -name '*.svg' -o -name '*.png' -o -name '*.py' \) \
    -exec install -Dm644 '{}' "$pkgdir/usr/share/pond-interface/{}" \;
  install -d "$pkgdir/etc/xdg/quickshell"
  ln -s /usr/share/pond-interface/shell "$pkgdir/etc/xdg/quickshell/pond-default"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
